{
  "dashboard": {
    "title": "Forum Application Dashboard",
    "panels": [
      {
        "title": "Request Rate (per second)",
        "targets": [
          {
            "expr": "rate(forum_http_requests_total[5m])"
          }
        ]
      },
      {
        "title": "Response Time (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(forum_http_request_duration_seconds_bucket[5m]))"
          }
        ]
      },
      {
        "title": "Cache Hit Rate",
        "targets": [
          {
            "expr": "rate(forum_cache_hits_total[5m]) / (rate(forum_cache_hits_total[5m]) + rate(forum_cache_misses_total[5m]))"
          }
        ]
      },
      {
        "title": "Database Connections",
        "targets": [
          {
            "expr": "forum_db_connections_in_use",
            "legendFormat": "In Use"
          },
          {
            "expr": "forum_db_connections_idle",
            "legendFormat": "Idle"
          }
        ]
      }
    ]
  }
}
