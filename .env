# Rate Limiting Configuration for Development
# Increased limits for testing

# Global limits
GLOBAL_RPS=100
GLOBAL_BURST=150

# Per-user/IP limits
USER_RPM=100
IP_RPM=50

# Endpoint-specific limits
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Development: Higher limits for testing
REGISTER_ATTEMPTS=5
REGISTER_WINDOW_MINUTES=60

POSTS_PER_HOUR=100
COMMENTS_PER_HOUR=100
REACTIONS_PER_MINUTE=100
UPLOAD_REQUESTS_PER_MINUTE=5

# Feature flags
ENABLE_RATE_LIMIT=true
ENABLE_ENDPOINT_LIMITS=true
LOG_RATE_LIMIT_VIOLATIONS=true

QUARANTINE_POLL_INTERVAL=1s