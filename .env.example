# Database (PostgreSQL)
# Use DB_SOURCE for a full connection string (URL or key=value); it wins over the parts below.
# DB_SOURCE=postgres://user:password@localhost:5432/forum_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=forum_db
DB_SSLMODE=disable

# Object storage (MinIO AIStor) for image uploads.
# These point at the server the Go app dials; docker compose sets them itself from
# its own environment, so this block only matters for a local `go run`.
# The storage server is AIStor, which requires a license -- see minio.license and
# the `minio` service in docker-compose.yml. Nothing to configure here for that.
#
# Leave MINIO_ENDPOINT empty to run without uploads: the /api/upload/* and
# /api/v1/medias/* routes are then not registered and everything else works.
#
# MINIO_ENDPOINT is the address the server dials; MINIO_PUBLIC_ENDPOINT is the
# address the browser dials. They differ under docker compose (minio:9000 vs
# localhost:9000) and must not be swapped: pre-signed URLs are signed over the
# Host header, so a URL signed for one host is rejected at the other.
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# Region the requests are signed for. A single MinIO deployment has no regions, so
# any value works as long as it is set: with it empty, the SDK looks a bucket's
# region up over the network, which the browser-facing client cannot do.
MINIO_REGION=us-east-1
MINIO_QUARANTINE_BUCKET=forum-quarantine
MINIO_MEDIA_BUCKET=forum-media

# Rate Limiting Configuration

# Global limits
GLOBAL_RPS=100
GLOBAL_BURST=150

# Per-user/IP limits
USER_RPM=100
IP_RPM=50

# Endpoint-specific limits
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

REGISTER_ATTEMPTS=3
REGISTER_WINDOW_MINUTES=60

POSTS_PER_HOUR=10
COMMENTS_PER_HOUR=30

SEARCH_REQUESTS_PER_MINUTE=60

# Feature flags
ENABLE_RATE_LIMIT=true
ENABLE_ENDPOINT_LIMITS=true
LOG_RATE_LIMIT_VIOLATIONS=true
