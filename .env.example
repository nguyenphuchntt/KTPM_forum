# Database (PostgreSQL)
# Use DB_SOURCE for a full connection string (URL or key=value); it wins over the parts below.
# DB_SOURCE=postgres://user:password@localhost:5432/forum_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=forum_db
DB_SSLMODE=disable

# Rate Limiting Configuration

# Global limits
GLOBAL_RPS=100
GLOBAL_BURST=150

# Per-user/IP limits
USER_RPM=100
IP_RPM=50

# Endpoint-specific limits
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

REGISTER_ATTEMPTS=3
REGISTER_WINDOW_MINUTES=60

POSTS_PER_HOUR=10
COMMENTS_PER_HOUR=30

# Feature flags
ENABLE_RATE_LIMIT=true
ENABLE_ENDPOINT_LIMITS=true
LOG_RATE_LIMIT_VIOLATIONS=true
