# Rate Limiting Configuration for Production

# Global limits
GLOBAL_RPS=100
GLOBAL_BURST=150

# Per-user/IP limits
USER_RPM=100
IP_RPM=50

# Endpoint-specific limits
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Production: 3 registrations per hour
REGISTER_ATTEMPTS=3
REGISTER_WINDOW_MINUTES=60

POSTS_PER_HOUR=10
COMMENTS_PER_HOUR=30
REACTIONS_PER_MINUTE=60

# Feature flags
ENABLE_RATE_LIMIT=true
ENABLE_ENDPOINT_LIMITS=true
LOG_RATE_LIMIT_VIOLATIONS=true
